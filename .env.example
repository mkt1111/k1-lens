# K1-Lens runs fully offline. Leave these unset for the deterministic extractor.
# K1LENS_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# K1LENS_OPENAI_MODEL=gpt-4o-mini
# Live run, on a machine that has the key. The key is not printed.
# uv run k1lens eval --backend hybrid --live
# Optional: --model gpt-4o-mini --max-spend 3 --max-documents 2
# K1LENS_ANTHROPIC_MODEL=claude-sonnet-4-5
# K1LENS_OPENAI_BASE_URL=https://api.openai.com/v1
# K1LENS_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# OCR runs for image-only PDFs when a Tesseract binary is installed.
# Set this to 0 to skip OCR. Set it to 1 to require OCR even if detection fails.
# K1LENS_ENABLE_OCR=0

# Fields under this confidence are highlighted for review. Default 0.80.
# K1LENS_REVIEW_THRESHOLD=0.80
